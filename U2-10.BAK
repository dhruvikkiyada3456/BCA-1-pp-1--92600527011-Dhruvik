#include <stdio.h>
#include<conio.h>

void main()
{
	float q,p,d,t,fa;
	clrscr();
	printf(" enter quantity:");
	scanf("\n %f",&q);

	printf(" enter price:");
	scanf("\n %f",&p);

	printf(" enter discount:");
	scanf("\n %f",&d) ;

	t=q*p;
	fa=t-(t*d/100);
	printf("\n final amount:%.fz\n",fa);
	getch();
}
